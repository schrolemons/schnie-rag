# 自行配置；本文件不含真实凭据。不要直接指向原网站的生产向量分区。
PORT=8787
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_VECTOR_NAMESPACE=kb-demo
DEEPSEEK_API_KEY=
VECTOR_EMBEDDING_MODE=upstash-data
VECTOR_EMBEDDING_MODEL=
VECTOR_EMBEDDING_URL=https://api.openai.com/v1/embeddings
VECTOR_EMBEDDING_API_KEY=
VECTOR_EMBEDDING_DIMENSION=
CHAT_MIN_SCORE=0.35
CHAT_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://127.0.0.1:5173,http://localhost:5173
CHAT_ALLOWED_MODEL_HOSTS=
CHAT_DAILY_REQUESTS=30
CHAT_DAILY_TOKEN_BUDGET=300000
# 开启Turnstile时两项一起配置，前端变量在构建时注入。
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CHAT_SESSION_SECRET=
# 以下只用于启用自己的Webhook更新链路，不用于离线演示。
CONTENT_SYNC_GITHUB_TOKEN=
CONTENT_SYNC_WEBHOOK_SECRET=
CONTENT_SYNC_TARGET_REPOSITORY=

# 可选服务端私有说明；不要提交真实提示词，不要使用PUBLIC_前缀。
CHAT_SYSTEM_PROMPT=

# 本地同步保护阈值，不代表云服务套餐额度；按自己的Dashboard设定。
VECTOR_MAX_RECORDS=98000
VECTOR_MAX_STORAGE_BYTES=700000000
VECTOR_MAX_SYNC_REQUESTS=14000
VECTOR_MAX_SYNC_TRANSFER_BYTES=35000000000
