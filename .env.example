# 所有值由使用者自行配置；不连接作者的服务。
PORT=8787
VERCEL_DEMO_API_KEY=
# 三项仅用于模拟验证，不是真实CAPTCHA。
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_DEMO_TOKEN=
# 内存协调层的配置标识，不是云Redis凭据。
REDIS_SIMULATOR_KEY=
# 正常问答使用真实外部服务；需自行创建Upstash Vector。
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_VECTOR_NAMESPACE=kb-demo
VECTOR_EMBEDDING_MODE=upstash-data
VECTOR_EMBEDDING_MODEL=
VECTOR_EMBEDDING_URL=https://api.openai.com/v1/embeddings
VECTOR_EMBEDDING_API_KEY=
VECTOR_EMBEDDING_DIMENSION=
CHAT_MIN_SCORE=0.35
# OpenAI兼容Chat Completions完整URL，以及自己的模型标识。
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# 可选签名Webhook；不启用任何Actions。
CONTENT_SYNC_GITHUB_TOKEN=
CONTENT_SYNC_WEBHOOK_SECRET=
CONTENT_SYNC_TARGET_REPOSITORY=
# 正式同步的本地保护阈值，非云套餐额度。
VECTOR_MAX_RECORDS=98000
VECTOR_MAX_STORAGE_BYTES=700000000
VECTOR_MAX_SYNC_REQUESTS=14000
VECTOR_MAX_SYNC_TRANSFER_BYTES=35000000000
